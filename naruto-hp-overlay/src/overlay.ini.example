; ------------------------------------------------------------------
; naruto-hp-overlay 配置模板
; 复制成 overlay.ini 放在 exe 同目录。程序运行时会自己回写 [view] 段。
; ------------------------------------------------------------------

[adb]
; 模拟器 adb.exe 的完整路径
path=D:\leidian\LDPlayer14\adb.exe
; adb devices 里显示的设备名
serial=emulator-5554

[proc]
; 模拟器窗口的进程名：雷电9 = dnplayer.exe，夜神 = Nox.exe
; 叠加层要贴在这个窗口上，必须填对
window=dnplayer.exe

[view]
; 血条矩形（占屏幕宽高的比例）。留空则由程序自动测量后写回。
x=0.297917
y=0.167593
w=0.176500
h=0.072222

; ------------------------------------------------------------------
; [chain] / [enemy] 是「静态链」，用于换号 / 重启后重定位。
;
; 下面这组数值是某个账号某一局实测出来的【示例】，换账号、换版本都会变。
; 第一次使用请先跑  huoying.exe --dump  做全量扫描重新生成，
; 或直接删掉这两段让程序自己扫。
;
;   mod   : 模块名
;   root  : 模块内偏移（静态根，同版本稳定）
;   n     : 链级数
;   offN  : 依次解引用，最后一级是 HP 块内偏移
;   va    : 本局绝对地址（仅作参考，重启即失效）
;   pair  : 同一实体两份血块的间距（每个账号可能不同）
; ------------------------------------------------------------------
[chain]
mod=libil2cpp.so
root=4913E20
n=7
off0=19C30
off1=230
off2=80
off3=C0
off4=20
off5=18
off6=178
va=0
pair=56C0

[enemy]
mod=libil2cpp.so
root=5601570
n=10
off0=4FB0
off1=B8
off2=140
off3=1D0
off4=70
off5=8
off6=28
off7=0
off8=28
off9=178
va=0
pair=36C0

[mode]
; default=a 表示默认用「值A」作为结算血量
default=a
; 是否显示敌方血条
show_enemy=1
